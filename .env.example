# Nach .env kopieren und den Fine-grained PAT eintragen (Rechte: siehe README.md).
GH_TOKEN=github_pat_...

# Nur für ./run.sh --headless:
# Hartes Zeitlimit für den ganzen Lauf (Format von `timeout`, z. B. 90m, 2h)
RUN_TIMEOUT=90m
# Optionales Kostenlimit in USD (leer = kein Limit)
MAX_BUDGET_USD=

# Home-Assistant-Webhook für Benachrichtigungen (leer = keine). Wird nicht an Claude weitergegeben.
HA_WEBHOOK_URL=
# 1 = auch benachrichtigen, wenn es nichts zu tun gibt
NOTIFY_ALWAYS=
